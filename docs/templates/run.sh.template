#!/usr/bin/env bash
# run.sh — fresh-context Ralph loop
# Generated by /build from docs/templates/run.sh.template.
# Do NOT edit by hand — edit the template ([SOL-TPL] run.sh.template in Linear)
# and re-generate. Linux / macOS / WSL only. Requires: bash jq git bc claude.

set -uo pipefail

# ---- paths (interpolated by /build at generation time) ----
RALPH_DIR="{{RALPH_DIR}}"
COMMIT_PREFIX="{{COMMIT_PREFIX}}"
CONFIG_PATH="docs/.solo-config.json"
PROMPT_FILE="$RALPH_DIR/PROMPT.md"

# ---- backpressure commands, in declared order (interpolated by /build) ----
# First failure halts backpressure for the iteration; later commands are skipped.
BACKPRESSURE_COMMANDS=(
{{BACKPRESSURE_COMMANDS}}
)

# ---- state files ----
COUNTER_FILE="$RALPH_DIR/iteration.counter"
COST_FILE="$RALPH_DIR/cost.usd"
PID_FILE="$RALPH_DIR/run.pid"
LOCKFILE="$RALPH_DIR/RUNNING"
EXIT_STATUS_FILE="$RALPH_DIR/exit.status"
FIX_PLAN="$RALPH_DIR/fix_plan.md"
START_EPOCH=$(date +%s)

# ---- caps (from config; shipped defaults if config absent) ----
if [ -f "$CONFIG_PATH" ]; then
  MAX_ITER=$(jq -r '.ralph.max_iterations // 30' "$CONFIG_PATH")
  MAX_WALL_HOURS=$(jq -r '.ralph.max_wall_hours // 4' "$CONFIG_PATH")
  MAX_USD=$(jq -r '.ralph.max_usd_cost // 50' "$CONFIG_PATH")
else
  MAX_ITER=30; MAX_WALL_HOURS=4; MAX_USD=50
fi

# ---- portable sha256 ----
sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
  else shasum -a 256 | cut -d' ' -f1
  fi
}

# ---- lifecycle: signal traps release lockfile + pid file, record interrupted ----
finish() {
  if [ ! -s "$EXIT_STATUS_FILE" ]; then
    echo "interrupted" > "$EXIT_STATUS_FILE"
  fi
  rm -f "$LOCKFILE" "$PID_FILE"
  echo "Ralph exited: $(cat "$EXIT_STATUS_FILE" 2>/dev/null || echo unknown)"
}
trap finish EXIT INT TERM

set_exit() { echo "$1" > "$EXIT_STATUS_FILE"; }   # set terminal status, then break

# ---- init (idempotent across --continue: counter and cost are NOT reset) ----
mkdir -p "$RALPH_DIR/iterations"
: > "$EXIT_STATUS_FILE"                 # clear any stale terminal status
touch "$LOCKFILE"
echo "$$" > "$PID_FILE"
[ -f "$COUNTER_FILE" ] || echo 0 > "$COUNTER_FILE"
[ -f "$COST_FILE" ]    || echo 0 > "$COST_FILE"

DRIFT_HISTORY=()        # rolling window of last 3 first-FAIL hashes

while true; do
  # ---- 1. check caps (post-iteration semantics), then increment counter ----
  PREV=$(cat "$COUNTER_FILE")
  ITER=$((PREV + 1))
  if [ "$ITER" -gt "$MAX_ITER" ]; then set_exit "iteration_cap"; break; fi

  WALL_SECONDS=$(( $(date +%s) - START_EPOCH ))
  if [ "$(echo "$WALL_SECONDS > $MAX_WALL_HOURS * 3600" | bc -l)" -eq 1 ]; then
    set_exit "wall_cap"; break
  fi

  CUR_COST=$(cat "$COST_FILE")
  if [ "$(echo "$CUR_COST > $MAX_USD" | bc -l)" -eq 1 ]; then
    set_exit "cost_cap"; break
  fi

  echo "$ITER" > "$COUNTER_FILE"
  ITER_NNN=$(printf '%03d' "$ITER")
  ITER_DIR="$RALPH_DIR/iterations/$ITER_NNN"
  mkdir -p "$ITER_DIR"
  LOG="$ITER_DIR/log.txt"
  echo "=== iteration $ITER_NNN ===" | tee -a "$LOG"

  # ---- 2. spawn fresh-context Claude Code ----
  JSONL="$ITER_DIR/claude.jsonl"
  claude --dangerously-skip-permissions --output-format stream-json \
    -p "$(cat "$PROMPT_FILE")" > "$JSONL" 2>> "$LOG" || true

  # ---- 3. extract cost from the final result message; accumulate ----
  ITER_COST=$(jq -rs 'map(select(.type=="result")) | last | .total_cost_usd // 0' \
    "$JSONL" 2>/dev/null || echo 0)
  [ -z "$ITER_COST" ] && ITER_COST=0
  NEW_COST=$(echo "$CUR_COST + $ITER_COST" | bc -l)
  echo "$NEW_COST" > "$COST_FILE"
  echo "iter cost: \$$ITER_COST  cumulative: \$$NEW_COST" | tee -a "$LOG"

  # ---- 4. grep assistant message blocks for the completion promise ----
  PROMISE=0
  if jq -rs 'map(select(.type=="assistant"))
            | .[].message.content[]? | select(.type=="text") | .text' \
       "$JSONL" 2>/dev/null | grep -qF '<promise>BUILT</promise>'; then
    PROMISE=1
  fi

  # ---- 5. backpressure: declared order, first failure halts backpressure ----
  BP_LOG="$ITER_DIR/backpressure.log"
  : > "$BP_LOG"
  BP_GREEN=1
  for cmd in "${BACKPRESSURE_COMMANDS[@]}"; do
    echo "--- backpressure: $cmd ---" >> "$BP_LOG"
    if ! eval "$cmd" >> "$BP_LOG" 2>&1; then
      echo "FAIL: $cmd" >> "$BP_LOG"
      BP_GREEN=0
      break
    fi
  done

  # ---- 6. commit if working tree dirty ----
  if [ -n "$(git status --porcelain)" ]; then
    SUMMARY=$(git diff --unified=0 -- "$FIX_PLAN" 2>/dev/null \
      | grep -E '^\+' | grep -vE '^\+\+\+' | head -1 | sed 's/^+//' | cut -c1-72)
    [ -z "$SUMMARY" ] && SUMMARY="iteration $ITER_NNN"
    git add -A
    git commit -q -m "$COMMIT_PREFIX iter $ITER_NNN: $SUMMARY" || true
  fi

  # ---- 7. success exit: promise emitted AND fix_plan fully checked AND backpressure green ----
  UNCHECKED=$(grep -cE '^[[:space:]]*-[[:space:]]*\[ \]' "$FIX_PLAN" 2>/dev/null || true)
  [ -z "$UNCHECKED" ] && UNCHECKED=0
  if [ "$PROMISE" -eq 1 ] && [ "$UNCHECKED" -eq 0 ] && [ "$BP_GREEN" -eq 1 ]; then
    set_exit "built"; break
  fi

  # ---- 8. cap exits are handled at the top of the loop (post-iteration check) ----

  # ---- 9. drift check: 3 consecutive identical first-FAIL hashes ----
  if [ "$BP_GREEN" -eq 0 ]; then
    FIRST_FAIL=$(grep -m1 -E 'FAIL|Error|×|✗' "$BP_LOG" || true)
    if [ -n "$FIRST_FAIL" ]; then
      DRIFT_HASH=$(printf '%s' "$FIRST_FAIL" | sha256 | cut -c1-12)
      DRIFT_HISTORY+=("$DRIFT_HASH")
      DRIFT_HISTORY=("${DRIFT_HISTORY[@]: -3}")
      if [ "${#DRIFT_HISTORY[@]}" -eq 3 ] \
         && [ "${DRIFT_HISTORY[0]}" = "${DRIFT_HISTORY[1]}" ] \
         && [ "${DRIFT_HISTORY[1]}" = "${DRIFT_HISTORY[2]}" ]; then
        set_exit "drift"; break
      fi
    fi
  else
    DRIFT_HISTORY=()      # a green backpressure run resets the drift window
  fi
done

# Terminal status is in $EXIT_STATUS_FILE. The EXIT trap releases the lockfile
# and pid file. /build --finalize reads exit.status to decide its next move.
exit 0
