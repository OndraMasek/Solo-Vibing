# ═════════════════════════════════════════════════════════════════════════════
# §8  Halt card rendering — canonical D3.4 shape
# ═════════════════════════════════════════════════════════════════════════════

def _render_halt_card(stage: str, ticket: str, gates: list[GateResult]) -> str:
    """Aggregate per-D3.4 §Aggregation rules: primary halt = most-upstream
    halted gate's first halt; other halts listed; recommendation from primary.
    """
    failing = [g for g in gates if not g.passed]
    if not failing:
        return ""
    primary_gate = failing[0]   # first by firing order
    primary_halt = primary_gate.halts[0]
    other_halts: list[tuple[str, HaltCard]] = []
    for g in failing:
        for i, h in enumerate(g.halts):
            if g is primary_gate and i == 0:
                continue
            other_halts.append((g.gate_name, h))

    trigger_phrase = {
        "pre-flight": "pre-flight",
        "at-seal": "seal",
        "at-write": "at-write",
        "per-iteration": "iteration",
        "per-child": "per-child",
    }.get(primary_gate.trigger, primary_gate.trigger)

    lines = [
        f"HALT at /{stage} {trigger_phrase} for {ticket}",
        "",
        f"Primary: {primary_halt.full_code}",
        f"  {primary_halt.summary}",
    ]
    if other_halts:
        lines.append("")
        lines.append("Other gates that halted at this stage:")
        for gate_name, h in other_halts:
            lines.append(f"  {gate_name}: {h.full_code}")
            lines.append(f"    {h.summary}")
    lines.append("")
    lines.append("Recommendation:")
    for rline in (primary_halt.recommendation or "").splitlines() or [""]:
        lines.append(f"  {rline}")
    if primary_halt.diagnostic_context:
        lines.append("")
        lines.append("Diagnostic context:")
        for k, v in primary_halt.diagnostic_context.items():
            lines.append(f"  {k}: {v}")
    return "\n".join(lines)


# ═════════════════════════════════════════════════════════════════════════════
# §9  Per-stage dispatch
# ═════════════════════════════════════════════════════════════════════════════

def _run_stage(stage: str, ticket: str, single_gate: str | None = None) -> StageResult:
    """Evaluate all gates for a stage in declared firing order.

    When `single_gate` is non-None, evaluate only that gate name.
    """
    result = StageResult(stage=stage, ticket=ticket)
    order = STAGE_ORDER.get(stage)
    if order is None:
        raise SystemExit(EXIT_USAGE)   # caller maps to usage halt; should be pre-checked
    for gate_name in order:
        if single_gate and gate_name != single_gate:
            continue
        spec = GATES[gate_name]
        try:
            gr = spec.evaluator(ticket=ticket)
        except Exception as e:
            # An evaluator crash is a v0.2 walking-skeleton concern; surface
            # it as a halt rather than blowing up the CLI.
            gr = _gr(gate_name, stage, spec.trigger, [HaltCard(
                code="§evaluator-internal-error",
                summary=f"{gate_name} evaluator raised: {type(e).__name__}: {e}",
                recommendation=(
                    "This is a solo-verify defect, not a cascade halt. Report "
                    "to the framework repo with the diagnostic context below."
                ),
                diagnostic_context={
                    "gate_name": gate_name, "exception": str(e),
                    "ticket": ticket,
                },
            )])
        result.gates.append(gr)
    return result


# ═════════════════════════════════════════════════════════════════════════════
# §10 --reconcile per-stage handlers (F-Rev-2 carry-forward)
# ═════════════════════════════════════════════════════════════════════════════

def _reconcile_stage(stage: str, ticket: str, yes: bool = False) -> int:
    """Per-stage `--reconcile`: re-derive expected state from the upstream
    manifest's outputs; report drift; offer interactive or `--yes`-batch repair.

    F-Rev-2 carry-forward: v0.2 extends `--reconcile` to /onboard, /update-linear,
    /review, /verify, /retro (v0.1 ships it on /specify, /plan, /build, /wrap).

    v0.2 ships drift detection only; repair-on-confirm is a v0.2.x deliverable
    per D4.5 §What v0.2 does not ship. This function prints the drift report
    and the proposed repair, then exits 0 (no drift) or 1 (drift detected).
    """
    if stage not in STAGE_ORDER:
        sys.stderr.write(f"solo-verify: unknown stage '{stage}'\n")
        return EXIT_USAGE

    print(f"--reconcile {stage} {ticket}")
    print(f"(v0.2 walking-skeleton: drift detection only; repair is v0.2.x)")
    print()

    # Run the stage's gates to detect drift.
    result = _run_stage(stage, ticket)
    if result.passed:
        print(f"✓ no drift detected at /{stage} for {ticket}")
        return EXIT_PASS

    print(f"✗ drift detected at /{stage} for {ticket}:")
    print()
    print(_render_halt_card(stage, ticket, result.gates))
    print()
    if yes:
        print("--yes specified; repair would run here in v0.2.x. v0.2 exits with drift status.")
    else:
        print("Proposed repair actions (run with --yes to apply in v0.2.x):")
        for g in result.gates:
            if not g.passed:
                for h in g.halts:
                    rec = (h.recommendation or "").strip()
                    if rec:
                        print(f"  - [{g.gate_name}] {rec.splitlines()[0]}")
    return EXIT_HALT


# ═════════════════════════════════════════════════════════════════════════════
# §11 --list-gates and --explain rendering
# ═════════════════════════════════════════════════════════════════════════════

def _list_gates(stage_filter: str | None = None) -> str:
    """Render gate inventory. `solo-verify --list-gates` prints all gates;
    `solo-verify --list-gates <stage>` filters to one stage's gates.
    """
    lines: list[str] = []
    stages = [stage_filter] if stage_filter else STAGES
    for stage in stages:
        if stage not in STAGE_ORDER:
            return f"solo-verify: unknown stage '{stage}' (valid: {', '.join(STAGES)})"
        lines.append(f"/{stage}:")
        for gate_name in STAGE_ORDER[stage]:
            spec = GATES[gate_name]
            lines.append(f"  {gate_name}  [{spec.trigger}]")
        lines.append("")
    # Trailing blank line trimmed
    return "\n".join(lines).rstrip() + "\n"


def _explain_gate(stage_dot_gate: str) -> tuple[str, int]:
    """Render gate's predicate text, halt codes, recovery. Returns (text, exit_code).
    """
    # Accept both "stage.gate-suffix" (canonical) and bare "gate-name" if unique.
    spec: GateSpec | None = GATES.get(stage_dot_gate)
    if spec is None:
        # Try matching by name suffix
        candidates = [g for g in GATES.values() if g.name == stage_dot_gate]
        if len(candidates) == 1:
            spec = candidates[0]
    if spec is None:
        return (
            f"solo-verify: unknown gate '{stage_dot_gate}'. "
            f"Run `solo-verify --list-gates` to see all gates.\n",
            EXIT_USAGE,
        )
    lines = [
        f"{spec.name}",
        f"  Stage:     /{spec.stage}",
        f"  Trigger:   {spec.trigger}",
        "",
        "  Predicate set:",
    ]
    for pline in _wrap(spec.predicate_set, width=76, indent="    "):
        lines.append(pline)
    lines.append("")
    lines.append("  Halt codes:")
    for h in spec.halt_codes:
        lines.append(f"    {h}")
    lines.append("")
    lines.append("  Recovery:")
    for pline in _wrap(spec.recovery, width=76, indent="    "):
        lines.append(pline)
    return "\n".join(lines) + "\n", EXIT_PASS


def _wrap(text: str, width: int = 76, indent: str = "") -> list[str]:
    """Minimal word-wrap (stdlib `textwrap` would be cleaner but this avoids
    an import for one function)."""
    words = text.split()
    out: list[str] = []
    current = indent
    for w in words:
        if len(current) + len(w) + 1 > width and current.strip():
            out.append(current)
            current = indent + w
        else:
            current = (current + " " + w) if current.strip() else (indent + w)
    if current.strip():
        out.append(current)
    return out


# ═════════════════════════════════════════════════════════════════════════════
# §12 main() + argparse
# ═════════════════════════════════════════════════════════════════════════════

def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="solo-verify",
        description=(
            "Gate evaluator for the Solo Claude Stack cascade. "
            "Evaluates the D3.4 gate set against cascade manifests. "
            "Single-file Python stdlib (3.10+, no external deps)."
        ),
        epilog=(
            "Exit codes: 0=pass, 1=halt, 2=usage error, "
            "3=provenance halt (run --reconcile), 4=fs/Linear inconsistent."
        ),
    )

    # Top-level documentation flags
    p.add_argument("--list-gates", nargs="?", const="__ALL__", metavar="STAGE",
                   help="List gates (optionally filtered by stage).")
    p.add_argument("--explain", metavar="STAGE.GATE-NAME",
                   help="Explain a gate: predicate text, halts, recovery.")
    p.add_argument("--version", action="version", version="solo-verify v0.2")

    # Per-stage subcommands.
    sub = p.add_subparsers(dest="command", metavar="STAGE")

    # Standard per-stage commands
    stage_command_argnames = {
        "onboard":       "product",
        "specify":       "ticket",
        "review":        "ticket",
        "plan":          "ticket",
        "update-linear": "ticket",
        "build":         "ticket",
        "wrap":          "ticket",
        "verify":        "milestone",
        "retro":         "milestone",
    }
    for stage, argname in stage_command_argnames.items():
        sp = sub.add_parser(stage, help=f"Evaluate gates at /{stage}")
        sp.add_argument(argname.upper(), help=f"{argname} identifier")
        sp.add_argument("--gate", metavar="GATE-NAME",
                        help="Evaluate only the named gate.")
        sp.add_argument("--reconcile", action="store_true",
                        help="Re-derive expected state; report drift. F-Rev-2 carry-forward.")
        sp.add_argument("--yes", action="store_true",
                        help="With --reconcile: apply repair (v0.2.x — drift report only in v0.2).")
        sp.add_argument("--json", action="store_true",
                        help="Emit machine-readable JSON instead of human halt cards.")

    # Hook-invocation aliases — D2.2 §Hook/script table forms
    aliases = {
        "subagent":       "agent_id",
        "build-spawn":    "ticket",
        "build-finalize": "ticket",
        "milestone":      "id",
    }
    for cmd, argname in aliases.items():
        sp = sub.add_parser(cmd, help=f"Hook-invocation form: solo-verify {cmd} <{argname}>")
        sp.add_argument(argname.upper(), help=f"{argname} identifier")
        sp.add_argument("--json", action="store_true", help="JSON output")

    return p


def _emit_result(stage: str, ticket: str, result: StageResult, as_json: bool) -> None:
    if as_json:
        payload = {
            "stage": stage,
            "ticket": ticket,
            "passed": result.passed,
            "exit_code": result.exit_code,
            "gates": [
                {
                    "name": g.gate_name,
                    "trigger": g.trigger,
                    "passed": g.passed,
                    "halts": [
                        {
                            "code": h.code,
                            "sub_case": h.sub_case,
                            "full_code": h.full_code,
                            "summary": h.summary,
                            "recommendation": h.recommendation,
                            "diagnostic_context": h.diagnostic_context,
                        }
                        for h in g.halts
                    ],
                    "evidence": g.evidence,
                }
                for g in result.gates
            ],
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if result.passed:
            evaluated = [g.gate_name for g in result.gates]
            print(f"PASS at /{stage} for {ticket} — gates evaluated: {len(evaluated)}")
            if not evaluated:
                print("  (no gates evaluated; verify the stage / single-gate is correct)")
        else:
            print(_render_halt_card(stage, ticket, result.gates))


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)

    # Documentation flags (--list-gates, --explain) take precedence over command.
    if args.list_gates is not None:
        stage_filter = None if args.list_gates == "__ALL__" else args.list_gates
        print(_list_gates(stage_filter), end="")
        return EXIT_PASS

    if args.explain:
        text, code = _explain_gate(args.explain)
        sys.stdout.write(text)
        return code

    if args.command is None:
        parser.print_usage()
        sys.stderr.write("solo-verify: a stage (or --list-gates / --explain) is required.\n")
        return EXIT_USAGE

    # FS-inconsistency early check: if .cascade/manifests/ is absent for any
    # command that needs it, return exit 4. Exempt --list-gates / --explain.
    ok_fs, reason = _cascade_fs_ready()
    if not ok_fs and args.command not in ("subagent", "build-spawn", "milestone"):
        sys.stderr.write(
            f"§cascade-fs-inconsistent: {reason}. "
            f"Run /onboard to bootstrap, or solo-cascade resume per D4.6 v1.1 "
            f"to re-derive state.\n"
        )
        return EXIT_FS_INCONSISTENT

    cmd = args.command

    # Hook-invocation aliases map to per-stage runs:
    #   build-finalize → run /build, single-gate=build.finalize
    #   build-spawn    → run /build, single-gate=build.provenance (pre-spawn check)
    #   milestone      → run /verify
    #   subagent       → run /review, single-gate=review.four-hat-objection-coverage
    as_json = getattr(args, "json", False)
    match cmd:
        case "build-finalize":
            ticket = args.TICKET
            result = _run_stage("build", ticket, single_gate="build.finalize")
            _emit_result("build", ticket, result, as_json)
            return result.exit_code
        case "build-spawn":
            ticket = args.TICKET
            result = _run_stage("build", ticket, single_gate="build.provenance")
            _emit_result("build", ticket, result, as_json)
            return result.exit_code
        case "milestone":
            mid = args.ID
            result = _run_stage("verify", mid)
            _emit_result("verify", mid, result, as_json)
            return result.exit_code
        case "subagent":
            aid = args.AGENT_ID
            # Derive the ticket from agent_id naming convention: <ticket>-<hat>.
            # If the convention doesn't match, treat agent_id as ticket.
            m = re.match(r"^(.+)-(user|engineer|pm|skeptic)$", aid)
            ticket = m.group(1) if m else aid
            result = _run_stage("review", ticket,
                                 single_gate="review.four-hat-objection-coverage")
            _emit_result("review", ticket, result, as_json)
            return result.exit_code

    # Standard per-stage path.
    if cmd not in STAGE_ORDER:
        sys.stderr.write(f"solo-verify: unknown stage '{cmd}'\n")
        return EXIT_USAGE

    # Resolve the ticket / milestone / product arg.
    id_arg = (
        getattr(args, "TICKET", None)
        or getattr(args, "MILESTONE", None)
        or getattr(args, "PRODUCT", None)
        or getattr(args, "ID", None)
    )
    if id_arg is None:
        sys.stderr.write(f"solo-verify: {cmd} requires an identifier.\n")
        return EXIT_USAGE

    # --reconcile per-stage handler
    if getattr(args, "reconcile", False):
        return _reconcile_stage(cmd, id_arg, yes=getattr(args, "yes", False))

    # --gate <name>: validate the gate name
    single_gate = getattr(args, "gate", None)
    if single_gate is not None and single_gate not in GATES:
        sys.stderr.write(
            f"solo-verify: unknown gate '{single_gate}'. "
            f"Run `solo-verify --list-gates {cmd}` to see gates for this stage.\n"
        )
        return EXIT_USAGE
    if single_gate is not None and GATES[single_gate].stage != cmd:
        sys.stderr.write(
            f"solo-verify: gate '{single_gate}' belongs to /{GATES[single_gate].stage}, not /{cmd}.\n"
        )
        return EXIT_USAGE

    result = _run_stage(cmd, id_arg, single_gate=single_gate)
    _emit_result(cmd, id_arg, result, as_json)
    return result.exit_code


if __name__ == "__main__":
    sys.exit(main())
