def _eval_plan_decomposition_shape(ticket: str, **_) -> GateResult:
    """`plan.decomposition-shape`: at-write; D3.1 hybrid-without-child-overrides
    + per-child Strategy field populated.
    """
    m = _read_manifest(ticket, "plan")
    if m is None:
        return _gr("plan.decomposition-shape", "plan", "at-write", [HaltCard(
            code="§plan-decomposition-invalid",
            summary=f"no /plan manifest at .cascade/manifests/{ticket}-plan.json",
            recommendation="Run /plan <ticket>.",
            diagnostic_context={"ticket": ticket},
        )])
    outputs = m.get("outputs", {}) or {}
    child_strategies = outputs.get("child_strategies", []) or []  # optional optimization
    children = outputs.get("child_tickets", []) or []
    parent_strategy = ((m.get("input_provenance", {}) or {}).get("parent_strategy")) \
                      or outputs.get("parent_decomposition_strategy")
    halts: list[HaltCard] = []
    if not children:
        halts.append(HaltCard(
            code="§plan-decomposition-invalid",
            summary="/plan manifest names zero children",
            recommendation="Re-run /plan; decomposer must emit at least one child.",
            diagnostic_context={"ticket": ticket},
        ))
    if parent_strategy == "hybrid":
        # Every child must carry an explicit non-inherited strategy.
        for entry in child_strategies:
            if not isinstance(entry, dict):
                continue
            if entry.get("strategy") in (None, "", "inherited"):
                halts.append(HaltCard(
                    code="§hybrid-without-child-overrides",
                    summary=(
                        f"hybrid parent's child {entry.get('child_id')} has no explicit strategy"
                    ),
                    recommendation=(
                        "/plan <ticket> --rerun=decompose and ensure every child of a "
                        "hybrid parent carries an explicit Strategy: field."
                    ),
                    diagnostic_context={
                        "child_id": entry.get("child_id"),
                        "ticket": ticket,
                    },
                ))
    return _gr("plan.decomposition-shape", "plan", "at-write", halts)


def _eval_plan_child_inheritance(ticket: str, **_) -> GateResult:
