    return _gr("wrap.linear-state-updated", "wrap", "at-write", halts)


# ─── /verify (milestone-level + per-child dispatch) ──────────────────────────

def _eval_verify_provenance(milestone: str, **_) -> GateResult:
    """Walk each child's /wrap manifest chain. CLI-side: list children from
    the milestone's /plan manifest (treated as a milestone-level plan), then
    confirm each child's /wrap manifest exists.
    """
    plan = _read_manifest(milestone, "plan")
    if plan is None:
        return _gr("verify.provenance", "verify", "pre-flight", [HaltCard(
            code="§provenance-chain-broken",
            summary=f"no /plan manifest at .cascade/manifests/{milestone}-plan.json",
            recommendation="Ensure the milestone's /plan stage has sealed.",
            diagnostic_context={"milestone": milestone},
            exit_code=EXIT_PROVENANCE,
        )])
    outputs = plan.get("outputs", {}) or {}
    children = outputs.get("child_tickets", []) or []
    halts: list[HaltCard] = []
    for child in children:
        if not isinstance(child, str):
            continue
        wrap_path = _manifest_path(child, "wrap")
        if not wrap_path.is_file():
            halts.append(HaltCard(
                code="§provenance-chain-broken",
                summary=f"child {child} has no /wrap manifest",
                recommendation=f"Run /wrap {child} first.",
                diagnostic_context={
                    "child": child,
                    "milestone": milestone,
                    "expected_path": str(wrap_path.relative_to(PROJECT_DIR)),
                },
                exit_code=EXIT_PROVENANCE,
            ))
    return _gr("verify.provenance", "verify", "pre-flight", halts)


def _eval_verify_child_completion(milestone: str, **_) -> GateResult:
    """All children are scope:built + have /wrap manifests. CLI-side checks
    /wrap manifest presence; Linear-side scope:built check belongs in the hook.
    """
    plan = _read_manifest(milestone, "plan")
    if plan is None:
        return _gr("verify.child-completion", "verify", "pre-flight", [])
    outputs = plan.get("outputs", {}) or {}
    children = outputs.get("child_tickets", []) or []
    halts: list[HaltCard] = []
    for child in children:
        if not isinstance(child, str):
            continue
        wrap = _read_manifest(child, "wrap")
        if wrap is None:
            halts.append(HaltCard(
                code="§verify-child-not-built",
                summary=f"child {child} has no /wrap manifest",
                recommendation=f"Complete /build then /wrap for {child}.",
                diagnostic_context={"child": child, "milestone": milestone},
            ))
            continue
        wrap_outputs = wrap.get("outputs", {}) or {}
        if wrap_outputs.get("linear_label_transition") != "scope:built":
            halts.append(HaltCard(
                code="§verify-child-not-built",
                summary=f"child {child} is not labeled scope:built",
                recommendation=f"Complete /wrap {child}.",
                diagnostic_context={
                    "child": child,
                    "milestone": milestone,
                    "actual_label": wrap_outputs.get("linear_label_transition"),
                },
            ))
    return _gr("verify.child-completion", "verify", "pre-flight", halts)


def _evaluate_child_gate(
    child: str, recursion_depth: int = 0,
) -> tuple[GateResult, dict[str, Any]]:
    """Per-child dispatch for /verify per D3.4 §`/verify` gate dispatch by strategy.

    Returns (gate_result, outcome_entry_for_children_gate_outcomes).
    """
    # Read child's /specify manifest (via /wrap → /build → ... → /specify chain).
    # CLI-side, we read /specify directly for the strategy.
    spec_manifest = _read_manifest(child, "specify")
    if spec_manifest is None:
        gr = _gr("verify.perceptual-evidence", "verify", "per-child", [HaltCard(
            code="§perceptual-evidence-missing",
            sub_case="artifact-absent",
            summary=f"child {child} has no /specify manifest; cannot dispatch",
            recommendation=f"Run /specify {child} first.",
            diagnostic_context={"child": child},
        )])
        return gr, {
            "child_id": child, "strategy": "unknown", "gate": "(undispatchable)",
            "status": "halted",
            "halt_code": "§perceptual-evidence-missing/artifact-absent",
            "halt_diagnostic": gr.halts[0].summary if gr.halts else "",
        }

    strategy = (spec_manifest.get("outputs", {}) or {}).get("decomposition_strategy")
    outputs = spec_manifest.get("outputs", {}) or {}

    match strategy:
        case "walking-skeleton" | "capability-cluster":
            halts = _evaluate_perceptual_evidence(outputs, child,
                                                   extra_p4_for_api_boundary=False)
            gate_name = "verify.perceptual-evidence"
            predicates = ["P1", "P2", "P3"]
        case "api-boundary":
            halts = _evaluate_perceptual_evidence(outputs, child,
                                                   extra_p4_for_api_boundary=True)
            gate_name = "verify.perceptual-evidence"
            predicates = ["P1", "P2", "P3", "P4"]
        case "refactor-spike":
            halts = _evaluate_invariance(outputs, child)
            gate_name = "verify.invariance"
            predicates = ["P5", "P6", "P7", "P8", "P9"]
        case "hybrid":
            if recursion_depth >= 1:
                gr = _gr("verify.perceptual-evidence", "verify", "per-child",
                         [HaltCard(
                             code="§hybrid-nesting-too-deep",
                             summary=(
                                 f"child {child} is hybrid at recursion depth "
                                 f"{recursion_depth}; v0.2 caps at one level"
                             ),
                             recommendation="Flatten the hybrid nesting or defer to v0.2.x.",
                             diagnostic_context={"child": child, "depth": recursion_depth},
                         )])
                return gr, {
                    "child_id": child, "strategy": "hybrid",
                    "gate": "(recursion)", "status": "halted",
                    "halt_code": "§hybrid-nesting-too-deep",
                }
            # Recurse one level.
            grandchildren = (_read_manifest(child, "plan") or {}).get("outputs", {}).get(
                "child_tickets", []) or []
            sub_halts: list[HaltCard] = []
            sub_outcomes: list[dict[str, Any]] = []
            for gc in grandchildren:
                if not isinstance(gc, str):
                    continue
                gc_gr, gc_oc = _evaluate_child_gate(gc, recursion_depth=recursion_depth + 1)
                sub_halts.extend(gc_gr.halts)
                sub_outcomes.append(gc_oc)
            gr = _gr("verify.perceptual-evidence", "verify", "per-child", sub_halts)
            return gr, {
                "child_id": child, "strategy": "hybrid",
                "gate": "(recursive)", "status": "passed" if gr.passed else "halted",
                "grandchildren_count": len(sub_outcomes),
            }
        case _:
            gr = _gr("verify.perceptual-evidence", "verify", "per-child", [HaltCard(
                code="§strategy-missing",
                summary=(
                    f"child {child} has unknown decomposition_strategy='{strategy}'"
                ),
                recommendation=f"/specify {child} --unseal and re-seal with a valid strategy.",
                diagnostic_context={"child": child, "strategy": strategy},
            )])
            return gr, {
                "child_id": child, "strategy": str(strategy),
                "gate": "(undispatchable)", "status": "halted",
                "halt_code": "§strategy-missing",
            }

    gr = _gr(gate_name, "verify", "per-child", halts)
    outcome = {
        "child_id": child, "strategy": strategy, "gate": gate_name,
        "status": "passed" if gr.passed else "halted",
        "predicates_evaluated": predicates,
    }
    if gr.halts:
        outcome["halt_code"] = gr.halts[0].full_code
        outcome["halt_diagnostic"] = gr.halts[0].summary
    return gr, outcome


def _eval_verify_perceptual_evidence(milestone: str, **_) -> GateResult:
    """Aggregated per-child perceptual-evidence outcomes.

    Note: this gate fires per-child in the cascade. For CLI parity at the
    milestone grain, we aggregate every child's outcome into one GateResult.
    """
    plan = _read_manifest(milestone, "plan")
    if plan is None:
        return _gr("verify.perceptual-evidence", "verify", "per-child", [])
    children = (plan.get("outputs", {}) or {}).get("child_tickets", []) or []
    halts: list[HaltCard] = []
    for child in children:
        if not isinstance(child, str):
            continue
        gr, _outcome = _evaluate_child_gate(child)
        if gr.gate_name == "verify.perceptual-evidence":
            halts.extend(gr.halts)
    return _gr("verify.perceptual-evidence", "verify", "per-child", halts)


def _eval_verify_invariance(milestone: str, **_) -> GateResult:
    plan = _read_manifest(milestone, "plan")
    if plan is None:
        return _gr("verify.invariance", "verify", "per-child", [])
    children = (plan.get("outputs", {}) or {}).get("child_tickets", []) or []
    halts: list[HaltCard] = []
    for child in children:
        if not isinstance(child, str):
            continue
        gr, _outcome = _evaluate_child_gate(child)
        if gr.gate_name == "verify.invariance":
            halts.extend(gr.halts)
    return _gr("verify.invariance", "verify", "per-child", halts)


def _eval_verify_milestone_aggregation(milestone: str, **_) -> GateResult:
    """`verify.milestone-aggregation`: at-write (milestone); every child
    evaluated; per-child outcomes recorded to children_gate_outcomes[];
    no per-child gate halted.
    """
    plan = _read_manifest(milestone, "plan")
    if plan is None:
        return _gr("verify.milestone-aggregation", "verify", "at-write", [])
    children = (plan.get("outputs", {}) or {}).get("child_tickets", []) or []
    outcomes: list[dict[str, Any]] = []
    halts: list[HaltCard] = []
    for child in children:
        if not isinstance(child, str):
            continue
        gr, outcome = _evaluate_child_gate(child)
        outcomes.append(outcome)
        if outcome.get("status") == "halted":
            halts.append(HaltCard(
                code="§verify-milestone-aggregation-failed",
                summary=f"child {child} halted: {outcome.get('halt_code')}",
                recommendation=outcome.get("halt_diagnostic", "See per-child diagnostic."),
                diagnostic_context=outcome,
            ))
    return _gr(
        "verify.milestone-aggregation", "verify", "at-write", halts,
        evidence={"children_gate_outcomes": outcomes},
    )


