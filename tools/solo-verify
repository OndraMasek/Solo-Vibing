def _eval_build_pyramid_tampering(ticket: str, **_) -> GateResult:
    """`build.pyramid-tampering`: pre-flight; pyramid_shape and per-entry tag
    from the spec markdown match the sealed manifest (no post-seal drift).

    Per D3.2 §Downstream consumer touch-points + Child 0001-B continuation 1
    `/build` amendment Gate 2.
    """
    plan = _read_manifest(ticket, "plan") or _read_manifest(ticket, "update-linear")
    if plan is None:
        # No upstream → cannot evaluate.
        return _gr("build.pyramid-tampering", "build", "pre-flight", [])
    # Chain upstream to /specify to get the sealed pyramid_shape and seed.
    spec_manifest = _read_manifest(ticket, "specify")
    if spec_manifest is None:
        return _gr("build.pyramid-tampering", "build", "pre-flight", [])
    sealed_outputs = spec_manifest.get("outputs", {}) or {}
    sealed_pyramid = sealed_outputs.get("pyramid_shape")
    sealed_seed = sealed_outputs.get("failing_test_seed", []) or []
    sealed_tags = sorted((e.get("tag") for e in sealed_seed if isinstance(e, dict)))
    # Re-parse the current spec markdown and ensure the rendered tags match
    # the sealed set. CLI-side this is a recompute of the sealed_seed against
    # the manifest's recorded tags — the spec markdown parse lives in /build's
    # at-write logic. v0.2 surfaces a sha-only check here: spec_path's
    # AC-list sha must still chain.
    spec_path_rel = sealed_outputs.get("spec_path")
    halts: list[HaltCard] = []
    if spec_path_rel:
        spec_path = _resolve(spec_path_rel)
        if spec_path.is_file():
            # Look for `**Pyramid shape:**` declaration in the spec.
            text = spec_path.read_text(encoding="utf-8")
            m_p = re.search(r"\*\*Pyramid shape:\*\*\s+_?([a-z\-]+)_?-shaped", text)
            if m_p and sealed_pyramid is not None:
                claimed_strategy = m_p.group(1)
                sealed_strategy = sealed_pyramid.get("strategy")
                if claimed_strategy != sealed_strategy:
                    halts.append(HaltCard(
                        code="§pyramid-tampering-detected",
                        summary=(
                            f"spec markdown's Pyramid shape declaration '{claimed_strategy}' "
                            f"differs from sealed manifest's pyramid_shape.strategy "
                            f"'{sealed_strategy}'"
                        ),
                        recommendation=(
                            "Restore the spec markdown to the sealed shape, or re-run "
                            "/specify <ticket> --unseal."
                        ),
                        diagnostic_context={
                            "claimed_strategy": claimed_strategy,
                            "sealed_strategy": sealed_strategy,
                            "spec_path": spec_path_rel,
                            "ticket": ticket,
                        },
                    ))
    return _gr("build.pyramid-tampering", "build", "pre-flight", halts)


def _eval_build_test_execution(ticket: str, **_) -> GateResult:
    """`build.test-execution`: per-iteration (Ralph loop); v0.1 contract
    preserved verbatim. CLI-side we check the backpressure log's latest entry.
    """
    backpressure_path = PROJECT_DIR / ".ralph" / ticket / "backpressure.jsonl"
    if not backpressure_path.is_file():
        # No log → /build hasn't started yet. Not a halt; passive pass.
        return _gr("build.test-execution", "build", "per-iteration", [])
    try:
        last_line = backpressure_path.read_text(encoding="utf-8").rstrip().splitlines()[-1]
        last = json.loads(last_line)
    except (OSError, ValueError, IndexError):
        return _gr("build.test-execution", "build", "per-iteration", [HaltCard(
            code="§build-test-drift",
            summary=f"backpressure log at {backpressure_path.relative_to(PROJECT_DIR)} unreadable",
            recommendation="Inspect the log file directly; re-run /build <ticket> --continue.",
            diagnostic_context={"backpressure_path": str(backpressure_path), "ticket": ticket},
        )])
    if last.get("first_fail_hash_changed"):
        return _gr("build.test-execution", "build", "per-iteration", [HaltCard(
            code="§build-test-drift",
            summary="first-FAIL hash changed between iterations; Ralph detected drift",
            recommendation=(
                "Investigate the diverging test failure. The seed contract is the "
                "invariant; new failures indicate test-or-implementation drift."
            ),
            diagnostic_context={
                "last_backpressure": last, "ticket": ticket,
            },
        )])
    return _gr("build.test-execution", "build", "per-iteration", [])


def _eval_build_finalize(ticket: str, **_) -> GateResult:
    """`build.finalize`: at-write; fix_plan_unchecked_count == 0; every test
    in failing_test_seed_status[] recomputes to passing; commit exists; lock
    releases balanced.

    Load-bearing test case per the handoff (stop-orchestrator-hook.sh dispatch).
    """
    backpressure_path = PROJECT_DIR / ".ralph" / ticket / "backpressure.jsonl"
    halts: list[HaltCard] = []
    last: dict[str, Any] | None = None
    if backpressure_path.is_file():
        try:
            last_line = backpressure_path.read_text(encoding="utf-8").rstrip().splitlines()[-1]
            last = json.loads(last_line)
        except (OSError, ValueError, IndexError):
            last = None
    if last is None:
        halts.append(HaltCard(
            code="§build-finalize-incomplete",
            summary=(
                f"no backpressure log at .ralph/{ticket}/backpressure.jsonl; "
                f"/build has not produced finalize-ready evidence"
            ),
            recommendation=f"Run /build {ticket}; let Ralph complete its iteration cycle.",
            diagnostic_context={"ticket": ticket},
        ))
        return _gr("build.finalize", "build", "at-write", halts)
    if last.get("fix_plan_unchecked_count", -1) != 0:
        halts.append(HaltCard(
            code="§build-finalize-incomplete",
            summary=f"fix_plan_unchecked_count={last.get('fix_plan_unchecked_count')} (must be 0)",
            recommendation="Continue /build until every fix-plan item is checked.",
            diagnostic_context={
                "fix_plan_unchecked_count": last.get("fix_plan_unchecked_count"),
                "ticket": ticket,
            },
        ))
    seed_status = last.get("failing_test_seed_status", []) or []
    not_passing = [e for e in seed_status if isinstance(e, dict) and e.get("status") != "passing"]
    if not_passing:
        names = [e.get("name") for e in not_passing]
        halts.append(HaltCard(
            code="§build-finalize-incomplete",
            summary=f"{len(not_passing)} seed test(s) not passing at finalize",
            recommendation="Continue /build; all seed tests must pass before finalize.",
            diagnostic_context={
                "not_passing_count": len(not_passing),
                "not_passing_sample": names[:10],
                "ticket": ticket,
            },
        ))
    # Commit existence check
    commit_sha = last.get("commit_sha")
    if not commit_sha:
        halts.append(HaltCard(
            code="§build-finalize-incomplete",
            summary="no commit_sha recorded in latest backpressure entry",
            recommendation="Ensure /build commits the work to the feature branch.",
            diagnostic_context={"ticket": ticket},
        ))
    else:
        # `git cat-file -e` verifies the SHA exists in git's object store.
        try:
            proc = subprocess.run(
                ["git", "cat-file", "-e", commit_sha],
                cwd=PROJECT_DIR, capture_output=True, timeout=10,
            )
            if proc.returncode != 0:
                halts.append(HaltCard(
                    code="§build-finalize-incomplete",
                    summary=f"commit {commit_sha[:12]}... not found in git object store",
                    recommendation="Verify the build's commit was not rebased away.",
                    diagnostic_context={"commit_sha": commit_sha, "ticket": ticket},
                ))
        except (subprocess.SubprocessError, FileNotFoundError, subprocess.TimeoutExpired):
            # git unavailable → cannot verify; treat as soft-pass with note.
            pass
    return _gr("build.finalize", "build", "at-write", halts)


