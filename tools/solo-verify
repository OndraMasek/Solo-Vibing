def _sha256_string(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            h.update(chunk)
    return h.hexdigest()


def _sha256_manifest_self_zeroed(path: Path) -> str:
    """Recompute manifest sha with `manifest_sha256` field zeroed.

    Implements D2.1 v2 §Caller-side verification step 3.

    CANONICAL SERIALIZATION (SOL-119): the zeroed manifest is serialized as
    `json.dumps(data, sort_keys=True, separators=(",", ":"))` — compact,
    key-sorted, ASCII-escaped (ensure_ascii default), no trailing newline.
    This is THE canonical form; the bash hook substrate
    (`.claude/hooks/lib/common.sh` `sha256_manifest_self_zeroed`) delegates to
    python3 to produce byte-identical output, so the UserPromptSubmit gate and
    this CLI never disagree on a manifest's sha.
    """
    raw = path.read_text(encoding="utf-8")
    data = json.loads(raw)
    data["manifest_sha256"] = ""
    canonical = json.dumps(data, sort_keys=True, separators=(",", ":"))
    return _sha256_string(canonical)


def _ac_list_sha256_from_spec(spec_path: Path) -> str:
    """Extract bulleted AC list from a spec markdown and hash it.

    Per D2.1 v2 §input_provenance.ac_list_sha256: parse the
    `## Acceptance Criteria` section, take all top-level bulleted lines,
    strip leading bullet markers and whitespace, normalize line endings
    to `\\n`, concatenate, sha256.
    """
    text = spec_path.read_text(encoding="utf-8")
    in_ac = False
    bullets: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        # Match `## Acceptance criteria` (case-insensitive) or `## Acceptance Criteria`
        if re.match(r"^#{1,3}\s+acceptance\s+criteria\s*$", stripped, re.IGNORECASE):
            in_ac = True
            continue
        if in_ac and stripped.startswith("#"):  # next heading ends the AC section
            break
        if in_ac:
            m = re.match(r"^\s*[-*+]\s+(.+)$", line)
            if m:
                bullets.append(m.group(1).strip())
    if not bullets:
        return _sha256_string("")
    return _sha256_string("\n".join(bullets))


def _resolve(path_str: str | Path) -> Path:
    """Resolve a possibly-relative path against PROJECT_DIR."""
    p = Path(path_str)
    if p.is_absolute():
        return p
    return PROJECT_DIR / p


def _read_json_or_none(path: Path) -> dict[str, Any] | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def _read_run_state() -> dict[str, Any] | None:
    """Read .cascade/run-state.json at the canonical path per D2.1 v2.1."""
    return _read_json_or_none(_resolve(RUN_STATE_PATH))


def _read_manifest(ticket: str, stage: str) -> dict[str, Any] | None:
    """Read .cascade/manifests/<ticket>-<stage>.json."""
    p = _resolve(CASCADE_MANIFESTS_DIR) / f"{ticket}-{stage}.json"
    return _read_json_or_none(p)


def _manifest_path(ticket: str, stage: str) -> Path:
    return _resolve(CASCADE_MANIFESTS_DIR) / f"{ticket}-{stage}.json"


def _cascade_fs_ready() -> tuple[bool, str]:
    """Confirm .cascade/manifests/ exists. Returns (ok, reason)."""
    p = _resolve(CASCADE_MANIFESTS_DIR)
    if not p.is_dir():
        return False, f"{CASCADE_MANIFESTS_DIR}/ is absent at {p}"
    return True, ""


