# ═════════════════════════════════════════════════════════════════════════════
# §3  Data classes — PredicateResult, HaltCard, GateResult, GateSpec
# ═════════════════════════════════════════════════════════════════════════════

@dataclass(frozen=True)
class HaltCard:
    """Canonical halt-card shape per D3.4 §Multi-failure aggregation."""
    code: str                                  # "§provenance-chain-broken"
    summary: str                               # one-line problem statement
    recommendation: str = ""                   # multi-line OK
    diagnostic_context: dict[str, Any] = field(default_factory=dict)
    sub_case: str | None = None                # "missing-required", etc.
    exit_code: int = EXIT_HALT                 # overrideable for §provenance-* (→3)

    @property
    def full_code(self) -> str:
        return f"{self.code}/{self.sub_case}" if self.sub_case else self.code


@dataclass
class PredicateResult:
    """Result of evaluating one predicate within a gate."""
    passed: bool
    halt: HaltCard | None = None
    evidence: dict[str, Any] = field(default_factory=dict)


@dataclass
class GateResult:
    """Aggregated result of evaluating all predicates in one gate."""
    gate_name: str          # "spec.pyramid-shape"
    stage: str              # "specify"
    trigger: str            # "at-seal" / "pre-flight" / "at-write" / "per-iteration"
    passed: bool
    halts: list[HaltCard] = field(default_factory=list)
    evidence: dict[str, Any] = field(default_factory=dict)


@dataclass
class StageResult:
    """Aggregated result of evaluating all gates at one stage."""
    stage: str
    ticket: str
    gates: list[GateResult] = field(default_factory=list)

    @property
    def passed(self) -> bool:
        return all(g.passed for g in self.gates)

    @property
    def halts(self) -> list[HaltCard]:
        out: list[HaltCard] = []
        for g in self.gates:
            out.extend(g.halts)
        return out

    @property
    def exit_code(self) -> int:
        # Provenance / chain-broken halts route to exit 3 (triggers --reconcile
        # per D2.1 v2 / D4.5).
        if self.passed:
            return EXIT_PASS
        for h in self.halts:
            if h.exit_code == EXIT_PROVENANCE:
                return EXIT_PROVENANCE
            if h.code in {"§provenance-chain-broken", "§ac-list-drift",
                          "§four-hat-seal-broken"}:
                return EXIT_PROVENANCE
        return EXIT_HALT


@dataclass(frozen=True)
class GateSpec:
    """Declarative spec for one gate. Drives --list-gates, --explain, dispatch."""
    name: str                                  # "spec.pyramid-shape"
    stage: str                                 # "specify"
    trigger: str                               # "pre-flight" / "at-seal" / ...
    predicate_set: str                         # human-readable description
    halt_codes: list[str]                      # which halts this gate can emit
    recovery: str                              # text for --explain Recovery: line
    # The actual evaluator — fn(manifest_chain, ticket, project_dir) -> GateResult
    evaluator: Callable[..., GateResult] = field(repr=False, default=None)  # type: ignore


