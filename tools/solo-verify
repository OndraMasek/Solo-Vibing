def _eval_wrap_linear_state_updated(ticket: str, **_) -> GateResult:
    """`wrap.linear-state-updated`: at-write; Linear ticket label is
    `scope:built` and ticket is in Done.
    """
    m = _read_manifest(ticket, "wrap")
    if m is None:
        return _gr("wrap.linear-state-updated", "wrap", "at-write", [])
    outputs = m.get("outputs", {}) or {}
    label_transition = outputs.get("linear_label_transition")
    done = outputs.get("done_project_id")
    halts: list[HaltCard] = []
    if label_transition != "scope:built":
        halts.append(HaltCard(
