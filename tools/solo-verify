# §5  Predicate helpers — provenance chain check
# ═════════════════════════════════════════════════════════════════════════════

def _verify_chain_to_parent(
    ticket: str,
    expected_parent_stage_choices: set[str] | None = None,
) -> tuple[bool, HaltCard | None, dict[str, Any] | None]:
    """Verify the manifest chain to the upstream parent stage.

    Implements D2.1 v2 §Caller-side verification protocol steps 1–5 plus a
    soft step-3 check that the parent's `outputs.stage` (if present) is in
    `expected_parent_stage_choices` (when caller cares).

    Returns:
      (passed, halt_card | None, parent_manifest_dict | None)
    """
    run_state = _read_run_state()
    if run_state is None:
        return False, HaltCard(
            code="§provenance-chain-broken",
            summary=f"cascade run-state at {RUN_STATE_PATH} is absent or unparseable",
            recommendation=(
                "If this is a fresh repo, run /onboard. Otherwise, run "
                "`solo-cascade resume` per D4.6 v1.1 to re-derive run-state."
            ),
            diagnostic_context={
                "run_state_path": str(_resolve(RUN_STATE_PATH)),
                "ticket": ticket,
            },
            exit_code=EXIT_PROVENANCE,
        ), None

    last = run_state.get("last_completed_stage") or {}
    expected_path = last.get("postcondition_manifest_path")
    expected_sha  = last.get("postcondition_manifest_sha256")

    if not expected_path:
        return False, HaltCard(
            code="§provenance-chain-broken",
            summary="cascade run-state names no last_completed_stage manifest",
            recommendation=(
                "The cascade may be at /onboard's terminal (no work in progress); "
                "/specify is the typical entry point for a new feature."
            ),
            diagnostic_context={"ticket": ticket, "run_state_keys": sorted(run_state.keys())},
            exit_code=EXIT_PROVENANCE,
        ), None

    parent_path = _resolve(expected_path)
    if not parent_path.is_file():
        return False, HaltCard(
            code="§provenance-chain-broken",
            summary=f"expected upstream manifest at {expected_path} is absent",
            recommendation=(
                "--reconcile per D2.1 v2.1's chain-recovery pattern, OR "
                "--rerun=<stage> per D4.5 for absent-manifest cases."
            ),
            diagnostic_context={
                "expected_path": expected_path,
                "absolute_path": str(parent_path),
                "ticket": ticket,
            },
            exit_code=EXIT_PROVENANCE,
        ), None

    recomputed = _sha256_manifest_self_zeroed(parent_path)
    if expected_sha and recomputed != expected_sha:
        return False, HaltCard(
            code="§provenance-chain-broken",
            summary=(
                f"parent manifest sha mismatch at {expected_path}: "
                f"expected {expected_sha[:12]}..., got {recomputed[:12]}..."
            ),
            recommendation="--reconcile per D2.1 v2.1's chain-recovery pattern.",
            diagnostic_context={
                "expected_path": expected_path,
                "expected_sha": expected_sha,
                "recomputed_sha": recomputed,
                "ticket": ticket,
            },
            exit_code=EXIT_PROVENANCE,
        ), None

    parent_manifest = _read_json_or_none(parent_path)
    if parent_manifest is None:
        return False, HaltCard(
            code="§provenance-chain-broken",
            summary=f"parent manifest at {expected_path} is unparseable JSON",
            recommendation="--reconcile per D2.1 v2.1's chain-recovery pattern.",
            diagnostic_context={"expected_path": expected_path, "ticket": ticket},
            exit_code=EXIT_PROVENANCE,
        ), None

    if expected_parent_stage_choices is not None:
        parent_stage = parent_manifest.get("stage", "").lstrip("/")
        # Accept both leading-slash and no-slash forms.
        if parent_stage and parent_stage not in expected_parent_stage_choices:
            return False, HaltCard(
                code="§provenance-chain-broken",
                summary=(
                    f"upstream stage is '{parent_stage}'; expected one of "
                    f"{sorted(expected_parent_stage_choices)}"
                ),
                recommendation="--reconcile per D2.1 v2.1's chain-recovery pattern.",
                diagnostic_context={
                    "expected_path": expected_path,
                    "actual_stage": parent_stage,
                    "expected_stages": sorted(expected_parent_stage_choices),
                    "ticket": ticket,
                },
                exit_code=EXIT_PROVENANCE,
            ), parent_manifest

    return True, None, parent_manifest


def _verify_ac_list_chain(
    parent_manifest: dict[str, Any], ticket: str,
) -> tuple[bool, HaltCard | None]:
    """Verify that the spec's current AC-list-sha256 matches the parent
    manifest's recorded ac_list_sha256.

    Implements D2.1 v2 §AC-hash chain.
    """
    outputs = parent_manifest.get("outputs", {}) or {}
    spec_path_rel = outputs.get("spec_path") or (
        parent_manifest.get("input_provenance", {}) or {}
    ).get("spec_path")
    sealed_ac_sha = outputs.get("ac_list_sha256") or (
        parent_manifest.get("input_provenance", {}) or {}
    ).get("ac_list_sha256")
    if not spec_path_rel or not sealed_ac_sha:
        # No AC chain to check (e.g. /onboard manifest carries no spec).
        return True, None
    spec_path = _resolve(spec_path_rel)
    if not spec_path.is_file():
        return False, HaltCard(
            code="§ac-list-drift",
            summary=f"spec at {spec_path_rel} is absent; AC-list chain cannot verify",
            recommendation=(
                "If the spec was deleted, restore from VCS; otherwise re-run "
                "/specify --unseal to re-seal against the current spec."
            ),
            diagnostic_context={
                "spec_path": spec_path_rel,
                "sealed_ac_sha": sealed_ac_sha,
                "ticket": ticket,
            },
            exit_code=EXIT_PROVENANCE,
        )
    current = _ac_list_sha256_from_spec(spec_path)
    if current != sealed_ac_sha:
        return False, HaltCard(
            code="§ac-list-drift",
            summary=(
                f"AC list at {spec_path_rel} has changed since upstream sealed: "
                f"sealed {sealed_ac_sha[:12]}..., current {current[:12]}..."
            ),
            recommendation=(
                "Re-run /specify <ticket> --unseal to re-seal against the current "
                "AC list, then re-fire the cascade from the unseal point."
            ),
            diagnostic_context={
                "spec_path": spec_path_rel,
                "sealed_sha": sealed_ac_sha,
                "current_sha": current,
                "ticket": ticket,
            },
            exit_code=EXIT_PROVENANCE,
        )
    return True, None


# ═════════════════════════════════════════════════════════════════════════════
# §5b  Predicate helpers — pyramid shape / strategy-evidence
# ═════════════════════════════════════════════════════════════════════════════

def _check_pyramid_shape(
    manifest_outputs: dict[str, Any], ticket: str,
) -> list[HaltCard]:
    """Evaluate D3.2 predicates 1–7 against a /specify manifest's outputs.

    Returns the list of halt cards (empty list ≡ all passed).
    """
    halts: list[HaltCard] = []
    strategy = manifest_outputs.get("decomposition_strategy")
    pyramid  = manifest_outputs.get("pyramid_shape")
    seed     = manifest_outputs.get("failing_test_seed", []) or []
    seed_tags = {entry.get("tag") for entry in seed if isinstance(entry, dict)}

    # Predicate 7: hybrid → null shape AND empty seed
    if strategy == "hybrid":
        if pyramid is not None or len(seed) > 0:
            halts.append(HaltCard(
                code="§pyramid-shape-violation",
                sub_case="hybrid-nonempty",
                summary=(
                    "hybrid parent must defer pyramid shape and tests to children; "
                    "pyramid_shape must be null and failing_test_seed[] must be empty"
                ),
                recommendation=(
                    "/specify <ticket> --continue and remove parent-level pyramid_shape "
                    "and failing_test_seed[] entries; let /plan's decomposer carry the "
                    "per-child structure."
                ),
                diagnostic_context={
                    "strategy": strategy,
                    "pyramid_shape_is_null": pyramid is None,
                    "seed_length": len(seed),
                    "ticket": ticket,
                },
            ))
        return halts

    if strategy not in STRATEGIES:
        halts.append(HaltCard(
            code="§strategy-missing",
            summary=f"decomposition_strategy='{strategy}' is not in the canonical enum",
            recommendation=(
                "/specify <ticket> --continue and resolve the §Decomposition strategy "
                f"section to one of {sorted(STRATEGIES)}."
            ),
            diagnostic_context={
                "actual_strategy": strategy,
                "canonical_enum": sorted(STRATEGIES),
                "ticket": ticket,
            },
        ))
        return halts

    catalog = PYRAMID_CATALOG[strategy]

    # Predicate 1: pyramid_shape.strategy == decomposition_strategy
    if pyramid is None or pyramid.get("strategy") != strategy:
        halts.append(HaltCard(
            code="§pyramid-shape-violation",
            sub_case="strategy-mismatch",
            summary=(
                f"pyramid_shape.strategy='{pyramid.get('strategy') if pyramid else None}'"
                f" but decomposition_strategy='{strategy}'"
            ),
            recommendation="/specify <ticket> --continue and re-derive pyramid_shape from the strategy.",
            diagnostic_context={
                "pyramid_shape": pyramid,
                "decomposition_strategy": strategy,
                "ticket": ticket,
            },
        ))
        # Don't gate further checks on this; continue evaluating.

    # Predicate 2: shape content matches the catalog (set-equality)
    if catalog and pyramid:
        for key, want in (("required_tags", catalog["required"]),
                          ("optional_tags", catalog["optional"]),
                          ("forbidden_tags", catalog["forbidden"])):
            got = pyramid.get(key, []) or []
            if set(got) != set(want):
                halts.append(HaltCard(
                    code="§pyramid-shape-violation",
                    sub_case="shape-tampering",
                    summary=f"pyramid_shape.{key} mismatch vs catalog for strategy='{strategy}'",
                    recommendation="/specify <ticket> --continue and re-derive pyramid_shape from the catalog.",
                    diagnostic_context={
                        "field": key,
                        "expected": sorted(want),
                        "actual": sorted(got),
                        "strategy": strategy,
                        "ticket": ticket,
                    },
                ))

    # Predicate 6: refactor-spike → empty seed
    if strategy == "refactor-spike":
        if len(seed) > 0:
            halts.append(HaltCard(
                code="§pyramid-shape-violation",
                sub_case="refactor-spike-nonempty",
                summary="refactor-spike must have an empty failing-test seed",
                recommendation=(
                    "/specify <ticket> --continue and remove the seed entries. "
                    "Invariance is a /verify-time predicate, not an authored test."
                ),
                diagnostic_context={
                    "strategy": strategy,
                    "seed_length": len(seed),
                    "seed_names": [e.get("name") for e in seed if isinstance(e, dict)],
                    "ticket": ticket,
                },
            ))
        return halts

    # Predicates 3 + 4: required present / forbidden absent (for the three
    # non-refactor-spike, non-hybrid strategies).
    if catalog:
        missing = set(catalog["required"]) - seed_tags
        if missing:
            halts.append(HaltCard(
                code="§pyramid-shape-violation",
                sub_case="missing-required",
                summary=(
                    f"pyramid_shape requires {sorted(catalog['required'])}; "
                    f"missing from seed: {sorted(missing)}"
                ),
                recommendation=(
                    "/specify <ticket> --continue and add tests tagged with the "
                    "missing required tags."
                ),
                diagnostic_context={
                    "strategy": strategy,
                    "required": sorted(catalog["required"]),
                    "missing": sorted(missing),
                    "seed_tags": sorted({t for t in seed_tags if t}),
                    "ticket": ticket,
                },
            ))
        forbidden_present = seed_tags & set(catalog["forbidden"])
        if forbidden_present:
            halts.append(HaltCard(
                code="§pyramid-shape-violation",
                sub_case="forbidden-present",
                summary=(
                    f"forbidden tags present in seed: {sorted(forbidden_present)}; "
                    f"pyramid_shape forbids {sorted(catalog['forbidden'])} for {strategy}"
                ),
                recommendation=(
                    "/specify <ticket> --continue and retag or remove the offending entries."
                ),
                diagnostic_context={
                    "strategy": strategy,
                    "forbidden": sorted(catalog["forbidden"]),
                    "present": sorted(forbidden_present),
                    "ticket": ticket,
                },
            ))

    # Predicate 5: every entry tag is in-enum
    for entry in seed:
        if not isinstance(entry, dict):
            continue
        tag = entry.get("tag")
        if tag is not None and tag not in TAG_ENUM:
            halts.append(HaltCard(
                code="§pyramid-tag-invalid",
                summary=f"test '{entry.get('name')}' has tag '[{tag}]'; not in canonical enum",
                recommendation="/specify <ticket> --continue and retag to one of the canonical six.",
                diagnostic_context={
                    "test_name": entry.get("name"),
                    "invalid_tag": tag,
                    "canonical_enum": sorted(TAG_ENUM),
                    "ticket": ticket,
                },
            ))

    return halts


def _check_ac_coverage(
    manifest_outputs: dict[str, Any], ticket: str,
) -> list[HaltCard]:
    """Verify every AC in `acceptance_criteria` has at least one named test in
    `failing_test_seed[]`. Skipped for refactor-spike and hybrid parents.
    """
    strategy = manifest_outputs.get("decomposition_strategy")
    if strategy in {"refactor-spike", "hybrid"}:
        return []
    acs = manifest_outputs.get("acceptance_criteria", []) or []
    seed = manifest_outputs.get("failing_test_seed", []) or []
    covered: set[str] = set()
    for entry in seed:
        if not isinstance(entry, dict):
            continue
        for ac_id in entry.get("covers_ac", []) or []:
            covered.add(ac_id)
    halts: list[HaltCard] = []
    for ac in acs:
        ac_id = ac.get("id") if isinstance(ac, dict) else ac
        if ac_id and ac_id not in covered:
            halts.append(HaltCard(
                code="§incomplete-failing-test-seed",
                summary=f"AC {ac_id} has no named test in failing_test_seed[]",
                recommendation=f"/specify <ticket> --continue and add a named test covering {ac_id}.",
                diagnostic_context={
                    "uncovered_ac": ac_id,
                    "covered_acs": sorted(covered),
                    "ticket": ticket,
                },
            ))
    return halts


def _check_strategy_evidence(
    manifest_outputs: dict[str, Any], ticket: str,
) -> list[HaltCard]:
    """D3.3 seal-time strategy-evidence predicates.

    For perceptual strategies: every [perceptual] entry has artifact_path
    under docs/specs/NNNN-<slug>/perceptual/; for capability-cluster every
    [perceptual] entry also has artifact_type in the enum.

    For refactor-spike: invariance_artifact is populated; pass_set_path exists.
    """
    strategy = manifest_outputs.get("decomposition_strategy")
    halts: list[HaltCard] = []

    if strategy in {"walking-skeleton", "api-boundary", "capability-cluster"}:
        seed = manifest_outputs.get("failing_test_seed", []) or []
        for entry in seed:
            if not isinstance(entry, dict) or entry.get("tag") != "perceptual":
                continue
            artifact_path = entry.get("artifact_path")
            if not artifact_path:
                halts.append(HaltCard(
                    code="§pyramid-shape-violation",
                    sub_case="artifact-path-invalid",
                    summary=(
                        f"[perceptual] test '{entry.get('name')}' lacks artifact_path"
                    ),
                    recommendation=(
                        "/specify <ticket> --continue and add artifact_path under "
                        "docs/specs/NNNN-<slug>/perceptual/."
                    ),
                    diagnostic_context={
                        "test_name": entry.get("name"),
                        "strategy": strategy,
                        "ticket": ticket,
                    },
                ))
                continue
            # Path-shape check: must live under docs/specs/NNNN-<slug>/perceptual/
            if not re.match(r"docs/specs/\d{4}-[^/]+/perceptual/", artifact_path):
                halts.append(HaltCard(
                    code="§pyramid-shape-violation",
                    sub_case="artifact-path-invalid",
                    summary=(
                        f"artifact_path '{artifact_path}' outside the "
                        f"docs/specs/NNNN-<slug>/perceptual/ convention"
                    ),
                    recommendation=(
                        "/specify <ticket> --continue and relocate the artifact under the convention."
                    ),
                    diagnostic_context={
                        "test_name": entry.get("name"),
                        "artifact_path": artifact_path,
                        "ticket": ticket,
                    },
                ))
            if strategy == "capability-cluster":
                artifact_type = entry.get("artifact_type")
                if not artifact_type or artifact_type not in CAPABILITY_ARTIFACT_TYPES:
                    halts.append(HaltCard(
                        code="§pyramid-shape-violation",
                        sub_case="artifact-path-invalid",
                        summary=(
                            f"capability-cluster [perceptual] test '{entry.get('name')}' "
                            f"has invalid or missing artifact_type='{artifact_type}'"
                        ),
                        recommendation=(
                            "/specify <ticket> --continue and set artifact_type to one of "
                            f"{sorted(CAPABILITY_ARTIFACT_TYPES.keys())}."
                        ),
                        diagnostic_context={
                            "test_name": entry.get("name"),
                            "artifact_type": artifact_type,
                            "valid_types": sorted(CAPABILITY_ARTIFACT_TYPES.keys()),
                            "ticket": ticket,
                        },
                    ))

    elif strategy == "refactor-spike":
        inv = manifest_outputs.get("invariance_artifact")
        if not inv or not isinstance(inv, dict):
            halts.append(HaltCard(
                code="§invariance-config-missing",
                summary="refactor-spike spec sealed without invariance_artifact populated",
                recommendation=(
                    "/specify <ticket> --continue and populate invariance.pass_set_capture_command "
                    f"in {SOLO_CONFIG_PATH}, then re-seal."
                ),
                diagnostic_context={"strategy": strategy, "ticket": ticket},
            ))
        else:
            pass_set_path_rel = inv.get("pass_set_path")
            if not pass_set_path_rel:
                halts.append(HaltCard(
                    code="§invariance-config-missing",
                    summary="invariance_artifact lacks pass_set_path",
                    recommendation="/specify <ticket> --continue and re-seal.",
                    diagnostic_context={"invariance_artifact": inv, "ticket": ticket},
                ))
            else:
                pass_set_path = _resolve(pass_set_path_rel)
                if not pass_set_path.is_file():
                    halts.append(HaltCard(
                        code="§perceptual-evidence-missing",
                        sub_case="artifact-absent",
                        summary=f"invariance pass-set file absent at {pass_set_path_rel}",
                        recommendation=(
                            "/specify <ticket> --continue and re-run the pass-set capture."
                        ),
                        diagnostic_context={
                            "strategy": strategy,
                            "pass_set_path": pass_set_path_rel,
                            "ticket": ticket,
                        },
                    ))
                else:
                    # Predicate: non-empty pass set
                    try:
                        lines = [l for l in pass_set_path.read_text().splitlines() if l.strip()]
                    except OSError:
                        lines = []
                    if not lines:
                        halts.append(HaltCard(
                            code="§invariance-pass-set-empty",
                            summary=f"invariance pass-set at {pass_set_path_rel} is empty",
                            recommendation=(
                                "Verify pass_set_capture_command produces a non-empty pass list; "
                                "re-run /specify <ticket> --continue after fixing."
                            ),
                            diagnostic_context={
                                "pass_set_path": pass_set_path_rel,
                                "ticket": ticket,
                            },
                        ))
    # hybrid is vacuously OK at parent grain — child stages carry the evidence.
    return halts


# ═════════════════════════════════════════════════════════════════════════════
# §5c  Predicate helpers — perceptual (P1-P4) and invariance (P5-P9)
# ═════════════════════════════════════════════════════════════════════════════

def _evaluate_perceptual_evidence(
    child_specify_outputs: dict[str, Any],
    child_ticket: str,
    extra_p4_for_api_boundary: bool,
) -> list[HaltCard]:
    """P1, P2, P3, plus P4 when api-boundary.

    P1: artifact at artifact_path exists.
    P2: re-run the named test; exit zero.
    P3: artifact bytes byte-equal to the post-test bytes (regenerated stably).
    P4 (api-boundary): integration-transcript markdown parses to minimum H1/H2/H3 schema.
    """
    halts: list[HaltCard] = []
    strategy = child_specify_outputs.get("decomposition_strategy")
    seed = child_specify_outputs.get("failing_test_seed", []) or []
    for entry in seed:
        if not isinstance(entry, dict) or entry.get("tag") != "perceptual":
            continue
        test_name = entry.get("name", "<unknown>")
        artifact_path_rel = entry.get("artifact_path")
        if not artifact_path_rel:
            # Caught at /specify seal; defensive at /verify.
            halts.append(HaltCard(
                code="§perceptual-evidence-missing",
                sub_case="artifact-absent",
                summary=f"[perceptual] test '{test_name}' has no artifact_path declared",
                recommendation="/specify <child> --unseal and add artifact_path to the seed entry.",
                diagnostic_context={
                    "test_name": test_name, "ticket": child_ticket, "strategy": strategy,
                },
            ))
            continue
        artifact_path = _resolve(artifact_path_rel)
        # P1 — artifact present
        if not artifact_path.is_file():
            halts.append(HaltCard(
                code="§perceptual-evidence-missing",
                sub_case="artifact-absent",
                summary=f"artifact at {artifact_path_rel} is absent for test '{test_name}'",
                recommendation=(
                    f"/build {child_ticket} and verify the test produces the artifact at the path."
                ),
                diagnostic_context={
                    "test_name": test_name,
                    "artifact_path": artifact_path_rel,
                    "ticket": child_ticket,
                    "strategy": strategy,
                },
            ))
            continue
        # P2 / P3 are inherently regeneration-and-compare and require a working
        # test runner. v0.2 surfaces P1 (presence) as the load-bearing check from
        # the standalone CLI; P2 / P3 fire when `solo-verify` is invoked from a
        # `/verify` skill context that knows how to re-run tests. The CLI path
        # records pre-test bytes; the in-skill path completes the round-trip.
        # Surfaced item in authoring notes.
        pre_test_sha = _sha256_file(artifact_path)
        # No CLI-side re-run in v0.2 (we don't know the test runner). Record
        # the pre-test sha as evidence; downstream consumer (the /verify skill)
        # supplies the post-test sha and compares.
        # P3 byte-stability check defers to the consumer; here we attest existence.
        # For api-boundary P4, the artifact is a markdown integration transcript;
        # check the minimum H1/H2/H3 schema.
        if extra_p4_for_api_boundary or strategy == "api-boundary":
            try:
                text = artifact_path.read_text(encoding="utf-8")
            except OSError:
                text = ""
            # Minimum schema: H1 `# Integration transcript`, at least one
            # `## Scenario:` H2, at least one `### Request` and one `### Response`.
            if not re.search(r"^#\s+Integration transcript\b", text, re.MULTILINE):
                halts.append(HaltCard(
                    code="§perceptual-evidence-missing",
                    sub_case="transcript-shape-violation",
                    summary=(
                        f"transcript at {artifact_path_rel} missing '# Integration transcript' H1"
                    ),
                    recommendation="Edit the transcript to start with `# Integration transcript`.",
                    diagnostic_context={
                        "test_name": test_name,
                        "artifact_path": artifact_path_rel,
                        "ticket": child_ticket,
                    },
                ))
            elif not re.search(r"^##\s+Scenario:", text, re.MULTILINE):
                halts.append(HaltCard(
                    code="§perceptual-evidence-missing",
                    sub_case="transcript-shape-violation",
                    summary=(
                        f"transcript at {artifact_path_rel} has no `## Scenario:` H2"
                    ),
                    recommendation="Add at least one `## Scenario:` block.",
                    diagnostic_context={
                        "test_name": test_name,
                        "artifact_path": artifact_path_rel,
                        "ticket": child_ticket,
                    },
                ))
            elif not (re.search(r"^###\s+Request\b", text, re.MULTILINE)
                      and re.search(r"^###\s+Response\b", text, re.MULTILINE)):
                halts.append(HaltCard(
                    code="§perceptual-evidence-missing",
                    sub_case="transcript-shape-violation",
                    summary=(
                        f"transcript at {artifact_path_rel} missing `### Request` or `### Response`"
                    ),
                    recommendation="Every scenario block must have ### Request and ### Response.",
                    diagnostic_context={
                        "test_name": test_name,
                        "artifact_path": artifact_path_rel,
                        "ticket": child_ticket,
                    },
                ))
    return halts


def _evaluate_invariance(
    child_specify_outputs: dict[str, Any],
    child_ticket: str,
) -> list[HaltCard]:
    """P5–P9 per D3.3 §Refactor-spike invariance predicate.

    P5: pass-set-at-seal.txt exists.
    P6: file sha equals manifest's pass_set_sha256.
    P7: solo-config's invariance.pass_set_capture_command hashes to capture_command_sha256.
    P8: re-run the capture command; exit zero, non-empty output.
    P9: every line in pass-set-at-seal appears in pass-set-at-verify (set-membership).
    """
    halts: list[HaltCard] = []
    inv = child_specify_outputs.get("invariance_artifact") or {}
    if not inv:
        halts.append(HaltCard(
            code="§invariance-config-missing",
            summary="refactor-spike child lacks invariance_artifact",
            recommendation="/specify <child> --unseal and re-seal with pass-set capture.",
            diagnostic_context={"ticket": child_ticket},
        ))
        return halts

    pass_set_rel = inv.get("pass_set_path")
    pass_set_sha256_sealed = inv.get("pass_set_sha256")
    capture_cmd = inv.get("capture_command")  # for diagnostic only
    capture_cmd_sha256_sealed = inv.get("capture_command_sha256")

    # P5
    if not pass_set_rel:
        halts.append(HaltCard(
            code="§perceptual-evidence-missing",
            sub_case="artifact-absent",
            summary="invariance_artifact lacks pass_set_path",
            recommendation="/specify <child> --unseal and re-seal.",
            diagnostic_context={"ticket": child_ticket, "strategy": "refactor-spike"},
        ))
        return halts
    pass_set_path = _resolve(pass_set_rel)
    if not pass_set_path.is_file():
        halts.append(HaltCard(
            code="§perceptual-evidence-missing",
            sub_case="artifact-absent",
            summary=f"invariance pass-set at {pass_set_rel} is absent",
            recommendation="Restore from VCS or /specify <child> --unseal.",
            diagnostic_context={
                "pass_set_path": pass_set_rel,
                "ticket": child_ticket,
                "strategy": "refactor-spike",
            },
        ))
        return halts

    # P6 — pass-set sha integrity
    current_pass_sha = _sha256_file(pass_set_path)
    if pass_set_sha256_sealed and current_pass_sha != pass_set_sha256_sealed:
        halts.append(HaltCard(
            code="§invariance-seal-tampering",
            summary=(
                f"pass-set at {pass_set_rel} sha mismatch: "
                f"sealed {pass_set_sha256_sealed[:12]}..., current {current_pass_sha[:12]}..."
            ),
            recommendation=(
                "The sealed pass-set file has been edited since seal. Restore from VCS, "
                "or /specify <child> --unseal if the change is intentional."
            ),
            diagnostic_context={
                "pass_set_path": pass_set_rel,
                "sealed_sha": pass_set_sha256_sealed,
                "current_sha": current_pass_sha,
                "ticket": child_ticket,
            },
        ))

    # P7 — capture command config integrity
    config_path = _resolve(SOLO_CONFIG_PATH)
    config = _read_json_or_none(config_path) or {}
    cfg_cmd = ((config.get("invariance") or {}).get("pass_set_capture_command") or "")
    if capture_cmd_sha256_sealed:
        cfg_cmd_sha = _sha256_string(cfg_cmd)
        if cfg_cmd_sha != capture_cmd_sha256_sealed:
            halts.append(HaltCard(
                code="§invariance-config-changed",
                summary=(
                    "invariance.pass_set_capture_command differs from sealed value"
                ),
                recommendation=(
                    "Restore the sealed command in docs/.solo-config.json, or /specify "
                    "<child> --unseal if the command change is intentional."
                ),
                diagnostic_context={
                    "config_path": SOLO_CONFIG_PATH,
                    "sealed_sha": capture_cmd_sha256_sealed,
                    "current_sha": cfg_cmd_sha,
                    "current_command": cfg_cmd,
                    "ticket": child_ticket,
                },
            ))

    # P8 + P9 — re-capture and set-membership.
    # CLI-side: re-running an unknown test runner is unsafe. We attempt the
    # capture command only if it's present; on failure we surface
    # §invariance-config-missing/capture-failed. If P8 succeeds, P9 set-membership
    # runs.
    if cfg_cmd:
        try:
            proc = subprocess.run(
                cfg_cmd, shell=True, capture_output=True, text=True,
                cwd=PROJECT_DIR, timeout=300,
            )
        except subprocess.TimeoutExpired:
            halts.append(HaltCard(
                code="§invariance-config-missing",
                sub_case="capture-failed",
                summary="pass-set capture command timed out after 300s",
                recommendation=(
                    "Investigate the capture command's runtime; consider scoping to "
                    "the refactor's relevant test subset."
                ),
                diagnostic_context={
                    "capture_command": cfg_cmd, "ticket": child_ticket,
                },
            ))
            return halts
        except Exception as e:
            halts.append(HaltCard(
                code="§invariance-config-missing",
                sub_case="capture-failed",
                summary=f"pass-set capture command failed to launch: {e}",
                recommendation=(
                    "Verify the command in docs/.solo-config.json is invocable in the "
                    "current shell."
                ),
                diagnostic_context={
                    "capture_command": cfg_cmd,
                    "error": str(e),
                    "ticket": child_ticket,
                },
            ))
            return halts
        if proc.returncode != 0 or not proc.stdout.strip():
            halts.append(HaltCard(
                code="§invariance-config-missing",
                sub_case="capture-failed",
                summary=(
                    f"capture exited {proc.returncode} or produced empty output"
                ),
                recommendation=(
                    "Investigate the test runner's failure; the invariance predicate "
                    "cannot evaluate without a captured pass-set."
                ),
                diagnostic_context={
                    "capture_command": cfg_cmd,
                    "exit_code": proc.returncode,
                    "stdout_len": len(proc.stdout),
                    "stderr_first_line": (proc.stderr or "").splitlines()[:1],
                    "ticket": child_ticket,
                },
            ))
            return halts

        # P9 — write pass-set-at-verify and compute set-membership
        spec_dir = pass_set_path.parent
        verify_path = spec_dir / "pass-set-at-verify.txt"
        try:
            verify_path.write_text(proc.stdout, encoding="utf-8")
        except OSError:
            # Non-fatal: the membership check still runs against in-memory output.
            pass
        sealed_set = {l.strip() for l in pass_set_path.read_text().splitlines() if l.strip()}
        verify_set = {l.strip() for l in proc.stdout.splitlines() if l.strip()}
        missing = sealed_set - verify_set
        if missing:
            halts.append(HaltCard(
                code="§invariance-pass-set-regression",
                summary=(
                    f"{len(missing)} sealed test(s) missing from verify-time pass-set"
                ),
                recommendation=(
                    "diff pass-set-at-seal.txt and pass-set-at-verify.txt; restore "
                    "the regressed tests, or /specify <child> --unseal if the "
                    "regression is intentional behaviour change."
                ),
                diagnostic_context={
                    "sealed_count": len(sealed_set),
                    "verify_count": len(verify_set),
                    "missing_count": len(missing),
                    "missing_sample": sorted(missing)[:10],
                    "ticket": child_ticket,
                },
            ))
    # If no capture command is configured, P7/P8/P9 are vacuously satisfied
    # (the P7 sha-equality is None == None); the upstream /specify gate would
    # have surfaced §invariance-config-missing already.

    return halts


# ═════════════════════════════════════════════════════════════════════════════
# §6  Per-gate evaluators — one function per gate, registered in GATES dict
# ═════════════════════════════════════════════════════════════════════════════
#
# Convention: each evaluator returns a GateResult. It uses the helpers above
# (chain check, pyramid, AC coverage, perceptual, invariance) plus per-stage
# manifest field-existence checks.
# ─────────────────────────────────────────────────────────────────────────────

def _gr(name: str, stage: str, trigger: str, halts: list[HaltCard],
        evidence: dict[str, Any] | None = None) -> GateResult:
    return GateResult(
        gate_name=name, stage=stage, trigger=trigger,
        passed=(len(halts) == 0), halts=halts, evidence=evidence or {},
    )


# ─── /onboard ────────────────────────────────────────────────────────────────

def _eval_onboard_linear_projects(ticket: str, **_) -> GateResult:
    """`onboard.linear-projects`: at-write; six Linear projects + Status doc +
    label namespace per D1 §/onboard changes + D2.1 v2 /onboard row.

    CLI-side: we cannot verify Linear API state without credentials. v0.2 ships
    a structural check on the /onboard manifest — if it sealed, the projects
    are presumed created by the /onboard skill. The Linear-side verification
    surfaces via the cascade's Linear-sync sanity hook (D2.2).
    """
    m = _read_manifest(ticket, "onboard")
    if m is None:
        return _gr("onboard.linear-projects", "onboard", "at-write", [HaltCard(
            code="§onboard-linear-init-failed",
            summary=f"no /onboard manifest at .cascade/manifests/{ticket}-onboard.json",
            recommendation="Run /onboard <product> to bootstrap Linear projects.",
            diagnostic_context={"ticket": ticket},
        )])
    outputs = m.get("outputs", {}) or {}
    projects = outputs.get("linear_projects_created", []) or []
    if len(projects) < 6:
        return _gr("onboard.linear-projects", "onboard", "at-write", [HaltCard(
            code="§onboard-linear-init-failed",
            summary=(
                f"manifest names {len(projects)}/6 Linear projects; D1 requires "
                "Product / Architecture / Design / Milestones / Backlog / Done."
            ),
            recommendation=(
                "Re-run /onboard <product>; ensure Linear API key has create-project "
                "permission and the team has space for six projects."
            ),
            diagnostic_context={
                "projects_created_count": len(projects),
                "projects_required_count": 6,
                "ticket": ticket,
            },
        )])
    if not outputs.get("status_doc_id"):
        return _gr("onboard.linear-projects", "onboard", "at-write", [HaltCard(
            code="§onboard-linear-init-failed",
            summary="Status document was not created under Product",
            recommendation="Re-run /onboard <product>.",
            diagnostic_context={"ticket": ticket},
        )])
    return _gr("onboard.linear-projects", "onboard", "at-write", [])


def _eval_onboard_config_write(ticket: str, **_) -> GateResult:
    """`onboard.config-write`: at-write; widened eight-predicate set per Child
    0001-B continuation 2 amendment (file exists, parses, marker, marker
    matches, linear.project_naming matches, workflow.default_strategy slot
    present + value in canonical-or-empty, invariance top-level key present).
    """
    config_path = _resolve(SOLO_CONFIG_PATH)
    if not config_path.is_file():
        return _gr("onboard.config-write", "onboard", "at-write", [HaltCard(
            code="§onboard-config-write-failed",
            summary=f"{SOLO_CONFIG_PATH} is absent",
            recommendation="Re-run /onboard <product>.",
            diagnostic_context={"config_path": SOLO_CONFIG_PATH, "ticket": ticket},
        )])
    cfg = _read_json_or_none(config_path)
    if cfg is None:
        return _gr("onboard.config-write", "onboard", "at-write", [HaltCard(
            code="§onboard-config-write-failed",
            summary=f"{SOLO_CONFIG_PATH} does not parse as JSON",
            recommendation="Fix syntax or re-run /onboard <product>.",
            diagnostic_context={"config_path": SOLO_CONFIG_PATH, "ticket": ticket},
        )])
    halts: list[HaltCard] = []
    if not cfg.get("marker"):
        halts.append(HaltCard(
            code="§onboard-config-write-failed",
            summary="config lacks `marker` field",
            recommendation="Edit docs/.solo-config.json to add `marker`: \"<3-letter code>\".",
            diagnostic_context={"config_keys": sorted(cfg.keys()), "ticket": ticket},
        ))
    # workflow.default_strategy slot structurally present (key exists; value
    # may be empty string per Child 0001-B continuation 2's skip-allowed semantics).
    workflow = cfg.get("workflow")
    if not isinstance(workflow, dict) or "default_strategy" not in workflow:
        halts.append(HaltCard(
            code="§onboard-config-write-failed",
            summary="config lacks `workflow.default_strategy` slot",
            recommendation=(
                "Re-run /onboard <product> to populate the slot, or edit "
                "docs/.solo-config.json to add workflow.default_strategy: \"\"."
            ),
            diagnostic_context={"ticket": ticket},
        ))
    elif workflow.get("default_strategy") and workflow["default_strategy"] not in STRATEGIES:
        halts.append(HaltCard(
            code="§onboard-config-write-failed",
            summary=(
                f"workflow.default_strategy='{workflow['default_strategy']}' "
                f"not in canonical enum or empty"
            ),
            recommendation=f"Set to one of {sorted(STRATEGIES)} or empty string to skip.",
            diagnostic_context={
                "actual_value": workflow.get("default_strategy"),
                "canonical_enum": sorted(STRATEGIES),
                "ticket": ticket,
            },
        ))
    # invariance top-level key (Child A's solo-config-additions.json contract)
    if "invariance" not in cfg:
        halts.append(HaltCard(
            code="§onboard-config-write-failed",
            summary="config lacks `invariance` top-level key",
            recommendation=(
                "Re-run /onboard <product> to populate the invariance slot, or "
                "add `\"invariance\": {\"pass_set_capture_command\": \"\"}`."
            ),
            diagnostic_context={"ticket": ticket},
        ))
    return _gr("onboard.config-write", "onboard", "at-write", halts)


