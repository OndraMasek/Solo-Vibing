        return _gr("wrap.tests-green", "wrap", "at-write", [])
    outputs = build.get("outputs", {}) or {}
    seed_status = outputs.get("failing_test_seed_status", []) or []
    not_passing = [e for e in seed_status if isinstance(e, dict) and e.get("status") != "passing"]
    if not_passing:
        return _gr("wrap.tests-green", "wrap", "at-write", [HaltCard(
            code="§wrap-tests-red",
            summary=f"{len(not_passing)} test(s) not passing at /wrap time",
            recommendation="Re-run /build to drive seed tests green; then re-run /wrap.",
            diagnostic_context={
                "not_passing_count": len(not_passing),
                "ticket": ticket,
            },
        )])
    return _gr("wrap.tests-green", "wrap", "at-write", [])


def _eval_wrap_mirror_sha_match(ticket: str, **_) -> GateResult:
    """`wrap.mirror-sha-match`: at-write; filesystem `docs/product/*.md` sha
