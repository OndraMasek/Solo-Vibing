def _eval_spec_strategy_annotation(ticket: str, **_) -> GateResult:
    """`spec.strategy-annotation`: at-seal; per D3.1 the step-1 annotation
    "proposed by /specify; founder to confirm" must clear before seal.
    """
    m = _read_manifest(ticket, "specify")
    if m is None:
        return _gr("spec.strategy-annotation", "specify", "at-seal", [])
    spec_path_rel = (m.get("outputs", {}) or {}).get("spec_path")
    if not spec_path_rel:
        return _gr("spec.strategy-annotation", "specify", "at-seal", [])
    spec_path = _resolve(spec_path_rel)
    if not spec_path.is_file():
        return _gr("spec.strategy-annotation", "specify", "at-seal", [])
    text = spec_path.read_text(encoding="utf-8")
    # Search the §Decomposition strategy section for the annotation.
    m_sec = re.search(
        r"^##\s+Decomposition\s+strategy\b.*?(?=^##\s+|\Z)",
        text, re.MULTILINE | re.DOTALL | re.IGNORECASE,
    )
    section_text = m_sec.group(0) if m_sec else ""
    if "proposed by /specify; founder to confirm" in section_text:
        return _gr("spec.strategy-annotation", "specify", "at-seal", [HaltCard(
            code="§strategy-annotation-unresolved",
            summary=(
                "spec sealed with the step-1 strategy annotation 'proposed by "
                "/specify; founder to confirm' still present"
            ),
            recommendation=(
                "Re-run /specify <ticket> --continue. At step 5, either accept "
                "the proposed strategy (which clears the annotation) or revise it."
            ),
            diagnostic_context={"spec_path": spec_path_rel, "ticket": ticket},
        )])
    return _gr("spec.strategy-annotation", "specify", "at-seal", [])


